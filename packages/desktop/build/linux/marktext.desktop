[Desktop Entry]
Name=MarkText-ja
Comment=Japanese-first MarkText markdown editor
Exec=marktext-ja %F
Terminal=false
Type=Application
Icon=marktext-ja
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;
Keywords=marktext-ja;marktext;
StartupWMClass=marktext-ja
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=marktext-ja --new-window %F
Icon=marktext-ja
